{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist-server/server.js",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,storage --project demo-calm-flames \"vitest run --config vitest.emulator.config.ts\"",
    "migrate:catalog": "tsx scripts/migrate-catalog.ts",
    "grant-admin": "tsx scripts/grant-admin.ts",
    "expire-reservations": "tsx scripts/expire-reservations.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/server.js --log-level=warning && node scripts/check-server-deps.mjs",
    "seed:taxonomy": "tsx scripts/seed-taxonomy.ts",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "migrate:coupons": "tsx scripts/migrate-coupons.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "esbuild": "^0.27.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.37.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
