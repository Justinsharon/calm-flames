rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin role lives ONLY on the user's Firestore document (customers/{uid}.role == 'admin'),
    // set with `npm run grant-admin -- <email>`. No hard-coded emails.
    function isValidCoupon(code, d) {
      return code.matches('^[A-Z0-9_-]{3,32}$')
        && d.code == code
        && d.type in ['percent', 'fixed']
        && d.value is number && d.value > 0 && (d.type == 'fixed' || d.value <= 100)
        && d.minOrder is number && d.minOrder >= 0
        && d.active is bool
        && (!('maxDiscount' in d) || (d.maxDiscount is number && d.maxDiscount > 0))
        && (!('expiresAt' in d) || d.expiresAt is string);
    }

    // Admins change fulfilment fields only (status, tracking); money and items stay as priced.
    function isValidOrderAdminUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'fulfillmentStatus', 'trackingUrl', 'adminNote', 'updatedAt'])
        && (!('trackingUrl' in request.resource.data) || request.resource.data.trackingUrl == null
            || (request.resource.data.trackingUrl is string && request.resource.data.trackingUrl.matches('^https://[^ ]+$')));
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.get('role', 'customer') == 'admin';
    }

    // Taxonomy slugs (keep in sync with src/lib/taxonomy.ts)
    function collectionSlugs() {
      return ['pillar-sculptural', 'jar-candles', 'coconut-shell', 'urli-centrepieces', 'floral-bouquets'];
    }
    function scentFamilySlugs() {
      return ['indian-botanical', 'floral', 'gourmand', 'spicy-resinous', 'luxury-woody', 'fresh-citrus'];
    }
    function occasionSlugs() {
      return ['christmas', 'birthday', 'wedding', 'housewarming', 'corporate'];
    }

    function optNumber(d, k) {
      return !(k in d) || (d[k] is number && d[k] >= 0);
    }
    function optString(d, k, maxLen) {
      return !(k in d) || (d[k] is string && d[k].size() <= maxLen);
    }
    function optStringList(d, k, maxItems) {
      return !(k in d) || (d[k] is list && d[k].size() <= maxItems);
    }

    // A product write may never make an unpriced product buyable: 'active' needs a price > 0.
    // Phase 4a fields are optional; older docs (legacy scentFamily labels, free-text tags) stay valid.
    function isValidProduct(d) {
      return d.price is number && d.price >= 0
        && d.priceStatus in ['active', 'missing']
        && (d.priceStatus != 'active' || d.price > 0)
        && d.isActive is bool
        && (!('collection' in d) || d.collection in collectionSlugs())
        && optString(d, 'scentFamily', 40)
        && (!('notes' in d) || (d.notes is map && d.notes.keys().hasOnly(['top', 'heart', 'base'])))
        && optNumber(d, 'burnTimeHours')
        && optNumber(d, 'weightGrams')
        && optString(d, 'sizeCm', 40)
        && optString(d, 'ingredients', 2000)
        && optString(d, 'shortDescription', 500)
        && optString(d, 'description', 5000)
        && optStringList(d, 'images', 12)
        && optStringList(d, 'tags', 30)
        && (!('occasions' in d) || (d.occasions is list && d.occasions.hasOnly(occasionSlugs())))
        && (!('boxEligible' in d) || d.boxEligible is bool)
        && optNumber(d, 'mrp');
    }

    function isValidTaxonomy(d, slug) {
      return d.slug == slug
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.sortOrder is number
        && optString(d, 'description', 2000)
        && optString(d, 'headerImage', 1000)
        && d.keys().hasOnly(['slug', 'name', 'description', 'headerImage', 'sortOrder', 'updatedAt', 'createdAt']);
    }

    // settings/store: every field optional (unset = feature off). Detailed checks in
    // src/lib/storeSettings.ts; rules enforce types and non-negative money.
    function isValidStoreSettings(d) {
      return d.keys().hasOnly(['freeShippingThreshold', 'shippingFee', 'codEnabled', 'codFee', 'codMaxOrder', 'buildABox', 'updatedAt'])
        && optNumber(d, 'freeShippingThreshold')
        && optNumber(d, 'shippingFee')
        && (!('codEnabled' in d) || d.codEnabled is bool)
        && optNumber(d, 'codFee')
        && optNumber(d, 'codMaxOrder')
        && (!('buildABox' in d) || (d.buildABox is map
              && d.buildABox.keys().hasOnly(['sizes', 'ribbons', 'addOns'])
              && d.buildABox.sizes is list && d.buildABox.sizes.size() <= 10
              && (!('ribbons' in d.buildABox) || (d.buildABox.ribbons is list && d.buildABox.ribbons.size() <= 20))
              && (!('addOns' in d.buildABox) || (d.buildABox.addOns is list && d.buildABox.addOns.size() <= 20))));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Catalogue: anyone can read ACTIVE products; only admins can read inactive ones or write.
    match /products/{productId} {
      allow read: if resource == null || resource.data.isActive == true || isAdmin();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Taxonomy (editable in admin). Only the fixed slugs may exist.
    match /collections/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && slug in collectionSlugs() && isValidTaxonomy(request.resource.data, slug);
      allow delete: if false;
    }
    match /scentFamilies/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && slug in scentFamilySlugs() && isValidTaxonomy(request.resource.data, slug);
      allow delete: if false;
    }
    match /occasions/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && slug in occasionSlugs() && isValidTaxonomy(request.resource.data, slug);
      allow delete: if false;
    }

    // Site content (journal, info pages, FAQ, contact, care). Visitors see published docs only.
    function isValidPage(d, slug) {
      return d.slug == slug
        && d.type in ['journal', 'info', 'faq', 'contact', 'care']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.body is string && d.body.size() <= 50000
        && d.published is bool
        && optString(d, 'summary', 400)
        && optString(d, 'eyebrow', 120)
        && optString(d, 'heroImage', 1000)
        && optString(d, 'category', 60)
        && optNumber(d, 'readMinutes')
        && optStringList(d, 'productIds', 24)
        && (!('featured' in d) || d.featured is bool);
    }
    match /pages/{slug} {
      allow read: if resource == null || resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidPage(request.resource.data, slug);
      allow delete: if isAdmin();
    }

    // Newsletter sign-ups are written only by the server (firebase-admin); never by clients.
    match /newsletterSubscribers/{id} {
      allow read, write: if false;
    }

    // Shop settings: public read (storefront needs shipping/COD), admin write.
    match /settings/{docId} {
      allow read: if docId == 'store';
      allow create, update: if isAdmin() && docId == 'store' && isValidStoreSettings(request.resource.data);
      allow delete: if false;
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons are read only by the server (firebase-admin) so codes cannot be listed.
    match /coupons/{couponCode} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidCoupon(couponCode, request.resource.data);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer' || isAdmin());
      allow update: if (isOwner(customerId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();

      match /cart/{itemId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /preferences/{prefId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /rituals/{ritualId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /rewards/{rewardId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow write: if isAdmin() || isOwner(customerId);
      }

      match /rewardTransactions/{txId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow write: if isAdmin() || isOwner(customerId);
      }
    }

    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      // Orders are created only by the server (/api/orders/create prices and reserves them).
      allow create: if false;
      allow update: if isAdmin() && isValidOrderAdminUpdate();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.customerId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    match /moodInteractions/{interactionId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /razorpayEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
