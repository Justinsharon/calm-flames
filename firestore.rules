rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin role lives ONLY on the user's Firestore document (customers/{uid}.role == 'admin'),
    // set with `npm run grant-admin -- <email>`. No hard-coded emails.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.get('role', 'customer') == 'admin';
    }

    // A product write may never make an unpriced product buyable: 'active' needs a price > 0.
    function isValidProduct(d) {
      return d.price is number && d.price >= 0
        && d.priceStatus in ['active', 'missing']
        && (d.priceStatus != 'active' || d.price > 0)
        && d.isActive is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Catalogue: anyone can read ACTIVE products; only admins can read inactive ones or write.
    match /products/{productId} {
      allow read: if resource == null || resource.data.isActive == true || isAdmin();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer' || isAdmin());
      allow update: if (isOwner(customerId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();

      match /cart/{itemId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /preferences/{prefId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /rituals/{ritualId} {
        allow read, write: if isOwner(customerId) || isAdmin();
      }

      match /rewards/{rewardId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow write: if isAdmin() || isOwner(customerId);
      }

      match /rewardTransactions/{txId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow write: if isAdmin() || isOwner(customerId);
      }
    }

    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if (
        (isSignedIn() && request.resource.data.customerId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.customerId is string) ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.customerId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    match /moodInteractions/{interactionId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /razorpayEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
