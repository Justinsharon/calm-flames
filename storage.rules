rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admins carry the custom claim `admin: true` (set by `npm run grant-admin -- <email>`, which
    // also sets role "admin" on their Firestore customers/{uid} document). A claim is used because
    // Storage rules cannot read the app's named Firestore database.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Product photos: anyone can read; only admins can upload / replace / delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Taxonomy header images (collections, scent families, occasions): same policy.
    match /taxonomy/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Images for journal stories and info pages.
    match /pages/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Help & Support: anyone (guests included) may attach ONE photo to a new support request.
    // Images only, up to 5 MB, never overwritten, never publicly readable (admins only).
    match /support/{requestId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create: if requestId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && fileName.matches('^photo[.](jpg|png|webp)$')
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
