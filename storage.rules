rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photos are public to read. Writes are added for admins in a later step.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
