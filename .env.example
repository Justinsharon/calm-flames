# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Server Firestore access (firebase-admin) ---
# On Cloud Run, leave these unset: Application Default Credentials (the service's
# service account) are used automatically. Grant it the "Cloud Datastore User" role.
# For local runs, point this at a service-account JSON key file (never commit it):
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# Optional overrides (defaults come from firebase-applet-config.json):
# FIREBASE_PROJECT_ID="groovy-patrol-413416"
# FIRESTORE_DATABASE_ID="ai-studio-thecalmflamearti-86cdffef-0b22-4392-a1f1-a015f3743f8e"
