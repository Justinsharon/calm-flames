# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Server Firestore access (firebase-admin) ---
# On Cloud Run, leave these unset: Application Default Credentials (the service's
# service account) are used automatically. Grant it the "Cloud Datastore User" role.
# For local runs, point this at a service-account JSON key file (never commit it):
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# Optional overrides (defaults come from firebase-applet-config.json):
# FIREBASE_PROJECT_ID="groovy-patrol-413416"
# FIRESTORE_DATABASE_ID="ai-studio-thecalmflamearti-86cdffef-0b22-4392-a1f1-a015f3743f8e"
# FIREBASE_STORAGE_BUCKET="groovy-patrol-413416.firebasestorage.app"

# --- Checkout master switch (Phase 4) ---
# Real checkout stays disabled unless this is exactly "true" AND every product is priced,
# inventory is readable, and Razorpay keys + webhook secret are set. Leave unset until Phase 4.
# CHECKOUT_ENABLED="true"

# --- Stale reservation expiry (CLAUDE.md issue 12) ---
# Shared secret for POST /api/admin/maintenance/expire-reservations (header X-Maintenance-Key),
# used by Cloud Scheduler. At least 16 characters. Store it as a Cloud Run secret, not in git.
# MAINTENANCE_SECRET="generate-a-long-random-value"
# Reservations older than this with no order are released (minimum 15, default 30).
# RESERVATION_MAX_AGE_MINUTES="30"
# Razorpay-paid orders still PAYMENT_PENDING after this long are checked with Razorpay and, if no
# captured/authorized payment exists, marked EXPIRED and their stock released (min 15, default 30).
# PAYMENT_PENDING_MAX_AGE_MINUTES="30"

# Order confirmation email (optional; unset = log and skip)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="The Calm Flame <orders@example.com>"
# Help & Support notifications (optional; needs the mailer above)
# SUPPORT_NOTIFY_EMAIL=
# GEMINI_MODEL=gemini-2.5-flash
# Public site origin; ONLY this host is indexable (unset on staging = noindex everywhere)
# PUBLIC_SITE_URL=https://thecalmflames.com
# New-order alerts to the shop (needs the mailer)
# ORDER_NOTIFY_EMAIL=
